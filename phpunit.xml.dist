<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <php>
        <!-- The suite peaks around 20M. A fixed, moderate limit makes a per-test leak fail
             early instead of passing on a runner with a high or unlimited default. -->
        <ini name="memory_limit" value="128M"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>
        <testsuite name="web">
            <directory>tests/web</directory>
        </testsuite>
    </testsuites>
</phpunit>
